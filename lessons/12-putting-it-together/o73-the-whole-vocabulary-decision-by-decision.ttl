#  SELECT ?property ?comment WHERE {
#    ?property a owl:DatatypeProperty ; rdfs:comment ?comment .
#    FILTER NOT EXISTS { ?property rdfs:range ?r }
#    FILTER(STRSTARTS(STR(?property), "https://example.org/bookshop-trail/schema#"))
#  } ORDER BY ?property
